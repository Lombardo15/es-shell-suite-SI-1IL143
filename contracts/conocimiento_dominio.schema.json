{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Estructura de conocimiento del dominio",
  "description": "Contrato JSON de conocimiento del dominio para ES-Shell Suite. Propuesta G4/G1 pendiente de aprobación de coordinadores.",
  "type": "object",
  "required": [
    "meta",
    "attributes",
    "rules"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "project_title",
        "version",
        "author_group"
      ],
      "properties": {
        "project_title": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "author_group": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "attributes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "numeric",
              "categorical",
              "boolean",
              "text"
            ]
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "range": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "depends_on": {
            "$ref": "#/$defs/condition"
          },
          "help_text": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "categorical"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "options"
              ],
              "properties": {
                "options": {
                  "minItems": 1
                }
              }
            }
          }
        ],
        "additionalProperties": true
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "priority",
          "conditions",
          "conclusion",
          "explanation_template"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "integer"
          },
          "conditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/condition"
            }
          },
          "conclusion": {
            "type": "object",
            "required": [
              "attribute_id",
              "value"
            ],
            "properties": {
              "attribute_id": {
                "type": "string",
                "minLength": 1
              },
              "value": {}
            },
            "additionalProperties": true
          },
          "explanation_template": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "condition": {
      "type": "object",
      "required": [
        "attribute_id",
        "operator",
        "value"
      ],
      "properties": {
        "attribute_id": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "type": "string",
          "enum": [
            "==",
            "!=",
            ">",
            "<",
            ">=",
            "<=",
            "in"
          ]
        },
        "value": {}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operator": {
                "const": "in"
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operator": {
                "enum": [
                  "==",
                  "!=",
                  ">",
                  "<",
                  ">=",
                  "<="
                ]
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "not": {
                  "type": "array"
                }
              }
            }
          }
        }
      ],
      "additionalProperties": true
    }
  }
}
