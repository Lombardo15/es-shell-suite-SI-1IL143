{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Estructura de conocimiento del dominio",
  "description": "Estructura y restricciones para validar bases de conocimiento.",
  "type": "object",
  "required": [
    "meta",
    "attributes",
    "rules"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "project_title",
        "version",
        "author_group"
      ],
      "properties": {
        "project_title": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "author_group": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "attributes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "type",
          "question"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "range": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "numeric"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "range"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "categorical"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "options"
              ],
              "properties": {
                "options": {
                  "minItems": 1
                }
              }
            }
          }
        ],
        "additionalProperties": true
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "priority",
          "conditions",
          "conclusion",
          "explanation_template"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "integer"
          },
          "conditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "attribute_id",
                "operator",
                "value"
              ],
              "properties": {
                "attribute_id": {
                  "type": "string",
                  "minLength": 1
                },
                "operator": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {}
              },
              "additionalProperties": true
            }
          },
          "conclusion": {
            "type": "object",
            "required": [
              "attribute_id",
              "value"
            ],
            "properties": {
              "attribute_id": {
                "type": "string",
                "minLength": 1
              },
              "value": {}
            },
            "additionalProperties": true
          },
          "explanation_template": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
